# ==============================================================================
# Souls Game Death Counter (SDC) — Environment Configuration Template
# Copy this file to .env and fill in your actual credentials.
# NEVER commit your real .env file or credentials to Git!
# ==============================================================================

# Supabase Project Configuration (Client & Backend)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-publishable-key
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# Upstash Redis REST Configuration (Optional)
# Used for distributed atomic rate limiting across serverless instances.
# If omitted, SDC automatically uses its built-in in-memory rate limiter.
UPSTASH_REDIS_REST_URL=https://your-redis-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token
